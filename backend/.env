# PostgreSQL Database Configuration
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/neuroutedb

# JWT Configuration (Change this to a strong random string in production)
SECRET_KEY=your-super-secret-key-change-this-in-production-with-a-strong-random-value

# Google OAuth Configuration
# Get these from: https://console.cloud.google.com/
GOOGLE_CLIENT_ID=your-google-client-id-here
GOOGLE_CLIENT_SECRET=your-google-client-secret-here

# Backend Configuration
BACKEND_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000

# Environment
ENVIRONMENT=development
